DATABASE_URL="file:./dev.db?socket_timeout=30&connection_limit=1"

KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=
KIOTVIET_AUTH_URL=https://id.kiotviet.vn/connect/token
KIOTVIET_API_URL=https://public.kiotapi.com

# GoClaw is optional. Configure GOCLAW_GATEWAY_TOKEN_FILE to a Docker secret
# mount in production; never expose the token through NEXT_PUBLIC_*.
GOCLAW_WS_URL=ws://goclaw:18790/ws
GOCLAW_MORNING_REPORT_PATH=/goclaw-workspace/quan-ly-kim/zlo-ql-kim/group_zlo-ql-kim_6244108299423959453/outputs/morning-report.json
GOCLAW_MORNING_REPORT_TEXT_PATH=/goclaw-workspace/quan-ly-kim/zlo-ql-kim/group_zlo-ql-kim_6244108299423959453/outputs/morning-report.txt
GOCLAW_GATEWAY_TOKEN_FILE=

# KiotViet internal stocktake writing stays disabled by default. The request
# export itself must be mounted as a Docker secret, never pasted here.
KIOTVIET_STOCKTAKE_WRITE_ENABLED=false
KIOTVIET_STOCKTAKE_WRITE_REQUEST_FILE=/run/secrets/kiotviet_stocktake_write_requests
