generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  kvProductId        Int                 @unique
  code               String?
  name               String
  fullName           String?
  categoryName       String?
  basePrice          Decimal?            @default(0)
  cost               Decimal?            @default(0)
  unit               String?
  isActive           Boolean             @default(true)
  rawJson            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoiceItems       InvoiceItem[]
  orderItems         OrderItem[]
  inventorySnapshots InventorySnapshot[]
  inventoryMovements InventoryMovement[]
  stocktakeLines     StocktakeLine[]
  dailyInventoryEntries ProductDailyInventoryEntry[]
  manualGroupAssignment InventoryGroupProduct?

  @@index([code])
  @@index([name])
  @@index([categoryName])
}

model InventoryGroup {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique
  storageArea String                 @default("UNASSIGNED")
  position    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assignments InventoryGroupProduct[]

  @@index([position])
  @@index([storageArea, position])
}

model InventoryGroupProduct {
  id        Int           @id @default(autoincrement())
  groupId   Int
  productId Int           @unique
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  group     InventoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
}

model Customer {
  id            Int       @id @default(autoincrement())
  kvCustomerId  Int       @unique
  code          String?
  name          String
  contactNumber String?
  address       String?
  rawJson       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  orders        Order[]

  @@index([code])
  @@index([name])
  @@index([contactNumber])
}

model Branch {
  id                 Int                 @id @default(autoincrement())
  kvBranchId         Int                 @unique
  name               String
  address            String?
  rawJson            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           Invoice[]
  orders             Order[]
  inventorySnapshots InventorySnapshot[]
  inventoryMovements InventoryMovement[]
  stocktakeDocuments StocktakeDocument[]
  dailyInventoryEntries ProductDailyInventoryEntry[]

  @@index([name])
}

model Invoice {
  id           Int           @id @default(autoincrement())
  kvInvoiceId  Int           @unique
  code         String?
  customerId   Int?
  branchId     Int?
  purchaseDate DateTime
  total        Decimal       @default(0)
  discount     Decimal       @default(0)
  status       String?
  rawJson      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer?     @relation(fields: [customerId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  items        InvoiceItem[]

  @@index([code])
  @@index([purchaseDate])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  productId Int?
  quantity  Decimal  @default(0)
  price     Decimal  @default(0)
  discount  Decimal  @default(0)
  subtotal  Decimal  @default(0)
  rawJson   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

/// Immutable audit records for quantity or status changes detected when an
/// already-synced invoice is refreshed from KiotViet.
model InvoiceItemChange {
  id                 Int      @id @default(autoincrement())
  kvInvoiceId        Int
  invoiceCode        String?
  branchId           Int?
  purchaseDate       DateTime
  productId          Int?
  productCode        String?
  productName        String?
  previousQuantity   Decimal  @default(0)
  currentQuantity    Decimal  @default(0)
  inventoryDelta     Decimal  @default(0)
  previousStatus     String?
  currentStatus      String?
  changeType         String
  sourceModifiedAt   DateTime?
  detectedAt         DateTime @default(now())
  rawJson            String

  @@index([productId, branchId, detectedAt])
  @@index([kvInvoiceId, detectedAt])
}

model Order {
  id           Int         @id @default(autoincrement())
  kvOrderId    Int         @unique
  code         String?
  customerId   Int?
  branchId     Int?
  purchaseDate DateTime
  createdDate  DateTime?
  modifiedDate DateTime?
  total        Decimal     @default(0)
  totalPayment Decimal     @default(0)
  discount     Decimal     @default(0)
  status       Int?
  statusValue  String?
  description  String?
  rawJson      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer?   @relation(fields: [customerId], references: [id])
  branch       Branch?     @relation(fields: [branchId], references: [id])
  items        OrderItem[]

  @@index([code])
  @@index([purchaseDate])
  @@index([createdDate])
  @@index([modifiedDate])
  @@index([customerId])
  @@index([branchId])
  @@index([statusValue])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productCode String?
  productName String?
  quantity    Decimal  @default(0)
  price       Decimal  @default(0)
  discount    Decimal  @default(0)
  subtotal    Decimal  @default(0)
  rawJson     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productCode])
}

model InventorySnapshot {
  id             Int      @id @default(autoincrement())
  snapshotDate   DateTime @default(now())
  productId      Int
  branchId       Int
  onHand         Decimal  @default(0)
  reserved       Decimal  @default(0)
  actualReserved Decimal  @default(0)
  rawJson        String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  branch         Branch   @relation(fields: [branchId], references: [id])

  @@index([snapshotDate])
  @@index([productId])
  @@index([branchId])
  @@index([productId, branchId, snapshotDate])
}

model InventoryMovement {
  id               Int      @id @default(autoincrement())
  movementKey      String   @unique
  sourceType       String
  sourceDocumentId String
  sourceLineKey    String
  documentCode     String?
  occurredAt       DateTime
  productId        Int
  branchId         Int
  quantityDelta    Decimal  @default(0)
  status           String?
  partnerName      String?
  isActive         Boolean  @default(true)
  rawJson          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([productId, branchId, occurredAt])
  @@index([sourceType, sourceDocumentId])
  @@index([branchId, occurredAt])
}

model StocktakeDocument {
  id              Int             @id @default(autoincrement())
  kvStocktakeId   Int             @unique
  code            String          @unique
  kvBranchId      Int
  branchId        Int?
  status          Int
  adjustmentDate  DateTime?
  sourceCreatedAt DateTime?
  sourceModifiedAt DateTime?
  createdByName   String?
  description     String?
  rawJson         String
  lastSyncedAt    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines           StocktakeLine[]

  @@index([branchId, adjustmentDate])
  @@index([status, adjustmentDate])
}

model StocktakeLine {
  id                    Int               @id @default(autoincrement())
  kvStocktakeDetailId   Int               @unique
  stocktakeDocumentId   Int
  kvProductId           Int
  productId             Int?
  productCode           String?
  productName           String?
  systemCount           Decimal           @default(0)
  actualCount           Decimal           @default(0)
  adjustmentValue       Decimal           @default(0)
  isActive              Boolean           @default(true)
  rawJson               String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  stocktakeDocument     StocktakeDocument @relation(fields: [stocktakeDocumentId], references: [id], onDelete: Cascade)
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([stocktakeDocumentId, isActive])
  @@index([productId, isActive])
  @@index([kvProductId])
}

model ProductDailyInventoryEntry {
  id              Int      @id @default(autoincrement())
  productId       Int
  branchId        Int
  businessDate    DateTime @db.Date
  openingOverride Decimal?
  actualOnHand    Decimal?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  audits          ProductDailyInventoryAudit[]

  @@unique([productId, branchId, businessDate])
  @@index([branchId, businessDate])
}

model ProductDailyInventoryAudit {
  id        Int      @id @default(autoincrement())
  entryId   Int
  previousJson String?
  nextJson  String
  actor     String   @default("local-admin")
  createdAt DateTime @default(now())
  entry     ProductDailyInventoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

model SyncLog {
  id           Int       @id @default(autoincrement())
  syncType     String
  status       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalRecords Int       @default(0)
  errorMessage String?

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

model ReportSnapshot {
  id               Int      @id @default(autoincrement())
  reportKey        String   @unique
  reportType       String
  periodLabel      String?
  periodFrom       DateTime?
  periodTo         DateTime?
  title            String
  payloadJson      String
  markdown         String
  sourceTablesJson String
  filtersJson      String
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reportType])
  @@index([periodFrom])
  @@index([periodTo])
  @@index([generatedAt])
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchDirectory {
  id            Int                    @id @default(autoincrement())
  customerCode  String?                @unique
  kvCustomerId  Int?                   @unique
  canonicalName String
  rawName       String?
  warehouse     String
  status        String
  routeType     String                 @default("UNSPECIFIED")
  day           String?
  sourceCell    String?
  notes         String?
  source        String                 @default("KNOWLEDGE_BASE")
  confirmedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  audits        BranchDirectoryAudit[]

  @@index([warehouse, status])
  @@index([canonicalName])
  @@index([source])
}

model BranchDirectoryAudit {
  id                Int             @id @default(autoincrement())
  branchDirectoryId Int
  action            String
  previousJson      String?
  nextJson          String
  actor             String          @default("local-admin")
  createdAt         DateTime        @default(now())
  branchDirectory   BranchDirectory @relation(fields: [branchDirectoryId], references: [id], onDelete: Cascade)

  @@index([branchDirectoryId, createdAt])
  @@index([action])
}
